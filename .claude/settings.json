{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git tag)",
      "Bash(git tag -l *)",
      "Bash(python run_pipeline.py *)",
