# Environment configuration: WHERE and HOW the pipeline runs.
# Business definitions (thresholds, windows, site rules) live in config/kpi_definitions.json, not here.

# R2 - AFDC station registry (US DOE). NOTE: developer.nrel.gov no longer resolves; use developer.nlr.gov.
AFDC_API_KEY=DEMO_KEY
AFDC_BASE_URL=https://developer.nlr.gov/api/alt-fuel-stations/v1.json
AFDC_STATES=TN,AL,KY,MS,GA,VA,NC
AFDC_EV_NETWORK=ChargePoint Network

# R1 - session exports (Hugging Face dataset, CC-BY-4.0)
HF_DATASET=shadenn/EV_Charging_demand
HF_FOLDER=raw_charging_stations

# S1 - simulated charger status feed (mock API)
STATUS_API_URL=http://127.0.0.1:8001
START_MOCK_API=true

# Reliability behaviour
MAX_RETRIES=4
RETRY_BASE_SECONDS=1
REQUEST_TIMEOUT_SECONDS=30
PAGE_SIZE=1000

# Simulation + logging
SIM_SEED=42
LOG_LEVEL=INFO
